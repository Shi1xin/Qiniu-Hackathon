# CLI Navigation Tool Configuration
# Copy this file to .env and fill in your actual values

# ===== LLM Configuration =====
# Choose ONE of the following API keys for location parsing and disambiguation

# Google Gemini 2.0 Flash (recommended for cost efficiency)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI GPT-4 (alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== Browser Configuration =====
# Browser settings (Chrome/Chromium only per clarification)

# Default browser type (chromium only supported)
NAV_TOOL_DEFAULT_BROWSER=chromium

# Run browser in headless mode (true/false)
NAV_TOOL_HEADLESS_MODE=false

# Browser window size (width x height)
NAV_TOOL_WINDOW_SIZE=1280,800

# Custom user agent string (optional)
# NAV_TOOL_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ===== Performance Configuration =====

# Total timeout for operations in milliseconds
NAV_TOOL_TIMEOUT_MS=10000

# Browser launch timeout in milliseconds
NAV_TOOL_BROWSER_TIMEOUT_MS=5000

# Network request timeout in milliseconds
NAV_TOOL_NETWORK_TIMEOUT_MS=3000

# Enable performance profiling (true/false)
NAV_TOOL_ENABLE_PROFILING=false

# Profile output directory
NAV_TOOL_PROFILE_DIR=/tmp/nav_cli_profile

# ===== Cache Configuration =====

# Enable parsing result caching (true/false)
NAV_TOOL_ENABLE_CACHE=true

# Cache TTL in seconds for location parsing results
NAV_TOOL_CACHE_TTL=3600

# Cache directory for persistent storage
NAV_TOOL_CACHE_DIR=/tmp/nav_cli_cache

# Cache maximum size in MB
NAV_TOOL_CACHE_MAX_SIZE=100

# ===== Map Service Configuration =====

# Primary map service provider (gaode, baidu, tencent)
NAV_TOOL_MAP_PROVIDER=gaode

# Fallback map service if primary fails
NAV_TOOL_FALLBACK_PROVIDER=baidu

# Transport mode preferences (car, walk, bus, ride, truck)
NAV_TOOL_TRANSPORT_MODE=car

# Route preferences (true/false)
NAV_TOOL_AVOID_TOLLS=false
NAV_TOOL_AVOID_HIGHWAYS=false

# ===== Logging Configuration =====

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
NAV_TOOL_LOG_LEVEL=INFO

# Log file path (optional, defaults to stdout)
# NAV_TOOL_LOG_FILE=/tmp/nav_cli.log

# Enable structured JSON logging (true/false)
NAV_TOOL_STRUCTURED_LOGGING=false

# Include performance metrics in logs (true/false)
NAV_TOOL_LOG_PERFORMANCE=true

# ===== Debug Configuration =====

# Enable debug mode for detailed output
NAV_TOOL_DEBUG=false

# Disable browser auto-close for debugging (true/false)
NAV_TOOL_DEBUG_KEEP_BROWSER=false

# Enable verbose agent execution logging
NAV_TOOL_VERBOSE_AGENT=false

# Network debugging (show HTTP requests/responses)
NAV_TOOL_DEBUG_NETWORK=false

# ===== Advanced Configuration =====

# Maximum number of retry attempts for failed operations
NAV_TOOL_MAX_RETRIES=1

# Retry delay in milliseconds (exponential backoff)
NAV_TOOL_RETRY_DELAY_MS=1000

# Enable location disambiguation prompts (true/false)
NAV_TOOL_ENABLE_DISAMBIGUATION=true

# Preferred city for context-based disambiguation
NAV_TOOL_PREFERRED_CITY=

# Language preference for responses (zh-CN, en-US)
NAV_TOOL_LANGUAGE=zh-CN